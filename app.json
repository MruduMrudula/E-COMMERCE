{
  "expo": {
    "name": "E-COMMERCE",
    "slug": "E-COMMERCE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/e-commerce-app-logo.png",
    "scheme": "ecommerce",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/e-commerce-app-logo.png",

        "backgroundColor": "#000000"
        
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.girijala.ECOMMERCE"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
           "image": "./assets/e-commerce-app-logo.png",
              "imageWidth": 200,
              "resizeMode": "contain",
             "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "742009e3-ab14-4ed8-a9d3-5188c5d6b8ef"
      }
    },
    "owner": "nanaamma"
  }
}
