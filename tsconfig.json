{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/modal.jsx",
    "app/_layout.Jsx",
    "app/(tabs)/_layout.jsx",
    "app/(tabs)/explore.jsx",
    "app/login.jsx",
    "nativewind-env.d.ts"
, "constants/theme.jsx"  ]
}